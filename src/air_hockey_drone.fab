// ============================================================================
// AI STATE AND DECISIONS
// ============================================================================
vars /air_hockey_drone
    DroneState[2] drone_states

fn handle_drone_mallet(U player)
    update_ai_state(player)
    execute_ai_behavior(player)

fn update_ai_state(U player)
    if drone_states[player].can_start_counter > 0
        drone_states[player].can_start_counter -= 1
        return

    if game_state.objects[player].cooldown_timer > 0
        game_state.objects[player].cooldown_timer -= 1

    if drone_states[player].hit_counter > AI_HIT_THRESHOLD
        drone_states[player].backoff_counter = AI_BACKOFF_DURATION
        drone_states[player].hit_counter = 0

    if drone_states[player].backoff_counter > 0
        drone_states[player].backoff_counter -= 1
        if drone_states[player].backoff_counter == 0
            drone_states[player].hit_counter = 0

    if drone_states[player].idle_frame_counter > 0
        drone_states[player].idle_frame_counter -= 1
    else
        drone_states[player].idle_frame_counter = THREE_SECONDS_FRAMES

fn execute_ai_behavior(U player)
    game_state.objects[player].vel = VEL_ZERO
    game_state.objects[player].boosting = false

    if drone_states[player].can_start_counter > 0
        return

    if game_state.objects[player].cooldown_timer > 0
        return

    if drone_states[player].backoff_counter > 0
        execute_backoff_behavior(player)
        return

    Bool puck_on_ai_side
    Bool puck_approaching_goal
    Bool puck_moving_away_from_goal

    if player == PLAYER_2
        // The top AI owns the center line so a stopped puck always has an attacker.
        puck_on_ai_side = game_state.objects[PUCK].pos.y <= RINK_DIMENSIONS.center_y
        puck_approaching_goal = (
            game_state.objects[PUCK].vel.y < -0.1
            && game_state.objects[PUCK].pos.y < RINK_DIMENSIONS.center_y + 20
            )
        puck_moving_away_from_goal = (
            game_state.objects[PUCK].vel.y > 0.1
            && game_state.objects[PUCK].pos.y < RINK_DIMENSIONS.center_y
            )
    else
        puck_on_ai_side = game_state.objects[PUCK].pos.y > RINK_DIMENSIONS.center_y
        puck_approaching_goal = (
            game_state.objects[PUCK].vel.y > 0.1
            && game_state.objects[PUCK].pos.y > RINK_DIMENSIONS.center_y - 20
            )
        puck_moving_away_from_goal = (
            game_state.objects[PUCK].vel.y < -0.1
            && game_state.objects[PUCK].pos.y > RINK_DIMENSIONS.center_y
            )

    Bool puck_slow_or_stationary_or_horizontal = (
        abs(game_state.objects[PUCK].vel.x) < 2.0 && abs(game_state.objects[PUCK].vel.y) < 0.7
        )

    UF distance_to_puck = (
        abs(game_state.objects[player].pos.x.a - game_state.objects[PUCK].pos.x.a)
        + abs(game_state.objects[player].pos.y.a - game_state.objects[PUCK].pos.y.a))
    Bool close_to_puck = distance_to_puck < AI_CLOSE_DISTANCE_THRESHOLD

    if puck_approaching_goal && !puck_slow_or_stationary_or_horizontal
        execute_defensive_behavior(player)
    else if (
        puck_on_ai_side
        && (
            puck_moving_away_from_goal
            || puck_slow_or_stationary_or_horizontal
            || close_to_puck
        )
    )
        execute_aggressive_behavior(player, close_to_puck, puck_slow_or_stationary_or_horizontal)
    else if puck_on_ai_side
        execute_counter_attack_behavior(player)
    else
        execute_neutral_behavior(player)

fn execute_defensive_behavior(U player)
    UF target_x = get_goal_target_x()
    move_drone_mallet_to_target(player, target_x, get_home_target_y(player), 5, MALLET_SPEED_BOOST)

fn execute_aggressive_behavior(U player, Bool close_to_puck, Bool puck_slow_or_stationary_or_horizontal)
    Vector2UF target = predict_puck_position(player)
    UF speed = MALLET_SPEED_NORMAL

    if close_to_puck || puck_slow_or_stationary_or_horizontal
        speed = MALLET_SPEED_BOOST

    move_drone_mallet_to_target(player, target.x, target.y, 3, speed)

fn execute_counter_attack_behavior(U player)
    Vector2UF target = predict_puck_position(player)
    move_drone_mallet_to_target(player, target.x, target.y, 4, MALLET_SPEED_BOOST)

fn execute_neutral_behavior(U player)
    if (
        (drone_states[player].idle_frame_counter == ONE_SECOND_FRAMES)
        || (drone_states[player].idle_frame_counter == (ONE_SECOND_FRAMES >> 1))
    )
        drone_states[player].idle_offset_x = SF(randb(41)) - 20
        drone_states[player].idle_offset_y = SF(randb(21)) - 10

    UF target_x = UF(SF(RINK_DIMENSIONS.center_x) + drone_states[player].idle_offset_x)
    UF target_y = get_idle_target_y(player, drone_states[player].idle_offset_y)
    move_drone_mallet_to_target(player, target_x, target_y, 3, MALLET_SPEED_NORMAL)

fn execute_backoff_behavior(U player)
    UF target_x = get_goal_target_x()
    move_drone_mallet_to_target(player, target_x, get_home_target_y(player), 5, MALLET_SPEED_BOOST)

fn get_goal_target_x() UF
    if game_state.objects[PUCK].pos.x.a < RINK_DIMENSIONS.left_net_x
        return UF(RINK_DIMENSIONS.left_net_x)
    if game_state.objects[PUCK].pos.x.a > RINK_DIMENSIONS.right_net_x
        return UF(RINK_DIMENSIONS.right_net_x)
    return game_state.objects[PUCK].pos.x

fn get_home_target_y(U player) UF
    if player == PLAYER_2
        return AI_MIN_Y
    return AI_MAX_Y

fn get_idle_target_y(U player, SF idle_offset_y) UF
    if player == PLAYER_2
        return UF(SF(RINK_DIMENSIONS.top_y) + 15 + idle_offset_y)
    return UF(SF(RINK_DIMENSIONS.bottom_y) - 15 + idle_offset_y)

fn predict_puck_position(U player) Vector2UF
    Vector2UF target = game_state.objects[PUCK].pos

    if abs(game_state.objects[PUCK].vel.x) > 0.5 || abs(game_state.objects[PUCK].vel.y) > 0.5
        target.x += game_state.objects[PUCK].vel.x * AI_PREDICTION_FRAMES
        target.y += game_state.objects[PUCK].vel.y * AI_PREDICTION_FRAMES

    target.x += rand_range(1, 5) - 2
    if player == PLAYER_2
        target.y -= rand_range(2,4)
    else
        target.y += rand_range(2,4)

    if target.y < AI_MIN_Y
        target.y = AI_MIN_Y
    else if target.y > AI_MAX_Y
        target.y = AI_MAX_Y

    return target

fn move_drone_mallet_to_target(U player, UF target_x, UF target_y, UF tolerance, UF speed)
    if (
        game_state.objects[player].pos.x.a < (target_x - tolerance)
        && !is_colliding_rink(MALLET_RADIUS, player, DIRECTION_RIGHT)
        )
        game_state.objects[player].vel.x += speed
    else if (
        game_state.objects[player].pos.x.a > (target_x + tolerance)
        && !is_colliding_rink(MALLET_RADIUS, player, DIRECTION_LEFT)
        )
        game_state.objects[player].vel.x -= speed

    if (
        game_state.objects[player].pos.y.a > (target_y + tolerance)
        && !is_colliding_rink(MALLET_RADIUS, player, DIRECTION_UP)
        )
        game_state.objects[player].vel.y -= speed
    else if (
        game_state.objects[player].pos.y.a < (target_y - tolerance)
        && !is_colliding_rink(MALLET_RADIUS, player, DIRECTION_DOWN)
        )
        game_state.objects[player].vel.y += speed
