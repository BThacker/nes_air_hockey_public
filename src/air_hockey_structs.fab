// ============================================================================
// STRUCTS
// ============================================================================
// Pixel-coordinate vector.
struct Vector2U
    U x
    U y

// Fixed-point position vector.
struct Vector2UF
    UF x
    UF y

// Signed fixed-point velocity vector.
struct Vector2SF
    SF x
    SF y

struct AnimObject
    Vector2UF pos
    Vector2SF vel
    U sprite

struct PhysicsObject // puck or mallet
    Vector2UF pos
    Vector2SF vel
    Bool boosting
    CCC/sprites metasprite
    U cooldown_timer

struct GameState
    Bool paused
    PhysicsObject[3] objects
    U player1_score
    U player2_score
    Vector2U last_hit_puck_position
    U last_hit_puck_counter
    U last_hit_puck_player
    Bool[2] mallet_touching_puck
    U friction_counter

struct DroneState
    U can_start_counter
    U backoff_counter
    U hit_counter
    U idle_frame_counter
    SF idle_offset_x
    SF idle_offset_y

struct LogoRinkBounds
    U left_x
    U right_x
    U top_y
    U bottom_y

struct RinkDimensions
    U left_x
    U right_x
    U top_y
    U bottom_y
    U left_net_x
    U right_net_x
    U center_y
    U center_x
    U center_y_p1_collision_check
    U center_y_p2_collision_check
